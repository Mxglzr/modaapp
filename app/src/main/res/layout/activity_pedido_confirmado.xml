<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Card de Éxito -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardBackgroundColor="@color/fondo_icono_clientes"
        app:cardCornerRadius="40dp"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_menu_pedidos"
            app:tint="#2E7D32" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvTituloConfirmado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="¡Pedido Registrado!"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNumeroPedidoConfirmado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Pedido #1 · Estado: PENDIENTE"
        android:textColor="@color/primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Botón WhatsApp al Cliente (HU-10 CA1) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWhatsAppCliente"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/color_whatsapp"
        android:text="Enviar a mi WhatsApp"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_whatsapp"
        app:iconGravity="textStart" />

    <!-- Botón WhatsApp a la Tienda (HU-10 CA2) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWhatsAppTienda"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="Avisar a la tienda"
        android:textAllCaps="false"
        android:textColor="@color/color_whatsapp"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_whatsapp"
        app:iconGravity="textStart"
        app:iconTint="@color/color_whatsapp"
        app:strokeColor="@color/color_whatsapp"
        app:strokeWidth="1.5dp" />

    <!-- Botón Volver al Menú / Inicio -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverInicio"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="Volver al Catálogo"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
